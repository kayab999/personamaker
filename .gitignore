# Build artifacts
/target
/dist
/src-tauri/target
/fuzz/target/
# Fuzz corpus: hand-written seed_* files are COMMITTED pins (tests/
# fuzz_corpus_seeds.rs guards them); libfuzzer-evolved hash-named inputs
# elsewhere are ignored so fuzz runs can grow the corpus locally without
# polluting commits.
fuzz/corpus/**/[0-9a-f]*
fuzz/artifacts/

# Tauri
tauri.conf.local.json

# Large model files (local testing only — never ship in installers)
*.gguf
*.bin
*.safetensors
test-models/
models/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Python bytecode (mock smoke runs)
__pycache__/
*.pyc

# Audit harness generated files (never commit captures/logs)
harness/mock_requests.jsonl
harness/mock_state.json
scripts/mock_state.json
# The mock server writes mock_hits.jsonl into its cwd (see
# scripts/mock_llama_server.py); it is a runtime log, not source.
scripts/mock_hits.jsonl
mock_hits.jsonl
harness/captures.jsonl
harness/soak.csv
harness/fidelity_out/
docs/handbook/AUDIT_0.9.0-rc.1/**/captures/

# Environment
.env
.env.local

# Node (if we ever add a build step)
node_modules/
package-lock.json

# Keep lockfile for reproducible app builds
# (do not ignore Cargo.lock for this binary crate)
/mock_requests.jsonl
