{
  "definitions": {
    "ImageReference": {
      "properties": {
        "height": {
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "mime_type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "path",
        "mime_type"
      ],
      "type": "object"
    }
  },
  "description": "Canonical JSON schemas for LocalPersona IPC types (Tauri commands). This is the contract. Update the golden file when Rust structs change.",
  "schemas": {
    "ChatMessage": {
      "properties": {
        "content": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "edited": {
          "default": false,
          "description": "True on revision-folded views (Phase B2): displayed content is the active revision of a user edit. Raw NDJSON rows never carry it.",
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "images": {
          "items": {
            "$ref": "#/definitions/ImageReference"
          },
          "type": "array"
        },
        "incomplete": {
          "default": false,
          "description": "True only for persisted partial stream turns (Phase B1 ABORTED/FAILED lifecycle). Never set on complete turns.",
          "type": "boolean"
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "narrator"
          ],
          "type": "string"
        },
        "speaker_id": {
          "type": "string"
        },
        "speaker_name": {
          "type": "string"
        },
        "timestamp": {
          "description": "Epoch millis",
          "type": "integer"
        },
        "token_count": {
          "default": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "speaker_id",
        "speaker_name",
        "content",
        "timestamp",
        "role"
      ],
      "type": "object"
    },
    "ConversationMetadata": {
      "properties": {
        "created_at": {
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "last_message_preview": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_message_timestamp": {
          "type": [
            "integer",
            "null"
          ]
        },
        "message_count": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "participant_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "updated_at": {
          "type": "integer"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "version",
        "id",
        "name",
        "participant_ids",
        "created_at",
        "updated_at",
        "message_count"
      ],
      "type": "object"
    },
    "EditRecord": {
      "description": "One stored revision of a message (Phase B2). Revisions live in conversations/{id}/revisions.ndjson, append-only; the active version of a message is its LAST record's new_content in append order.",
      "properties": {
        "edited_at": {
          "description": "Epoch millis",
          "type": "integer"
        },
        "message_id": {
          "description": "Target row id in messages.ndjson",
          "type": "string"
        },
        "new_content": {
          "description": "Full replacement - the active content after folding",
          "type": "string"
        },
        "old_content": {
          "description": "Content this revision replaced (captured at edit time)",
          "type": "string"
        },
        "previous_revision_id": {
          "description": "Supersession chain",
          "type": [
            "string",
            "null"
          ]
        },
        "revision_id": {
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "type": "integer"
        }
      },
      "required": [
        "revision_id",
        "message_id",
        "old_content",
        "new_content",
        "edited_at"
      ],
      "type": "object"
    },
    "ServerStartRequest": {
      "properties": {
        "ctx_size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "flash_attn": {
          "type": "boolean"
        },
        "gpu_layers": {
          "type": [
            "integer",
            "null"
          ]
        },
        "mmproj_path": {
          "description": "Path to multimodal projector",
          "type": [
            "string",
            "null"
          ]
        },
        "model_path": {
          "description": "Absolute path to GGUF model",
          "type": "string"
        },
        "preferred_port": {
          "type": [
            "integer",
            "null"
          ]
        },
        "threads": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "model_path",
        "flash_attn"
      ],
      "type": "object"
    },
    "ServerStatus": {
      "properties": {
        "api_base": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_requests_before_reset": {
          "type": "integer"
        },
        "model_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "port": {
          "type": [
            "integer",
            "null"
          ]
        },
        "request_count": {
          "type": "integer"
        },
        "running": {
          "type": "boolean"
        },
        "starting": {
          "type": "boolean"
        },
        "vision_enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "running",
        "starting",
        "vision_enabled",
        "request_count",
        "max_requests_before_reset"
      ],
      "type": "object"
    },
    "StoredCharacter": {
      "description": "Wire format is camelCase (serde rename_all). Deser also accepts snake_case aliases.",
      "properties": {
        "avatarColor": {
          "type": "string"
        },
        "avatarUrl": {
          "description": "Relative path like avatars/xxx.png (Rust field: avatar_path)",
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "description": "Epoch millis",
          "type": "integer"
        },
        "greeting": {
          "type": "string"
        },
        "hasKnowledgeBase": {
          "type": "boolean"
        },
        "id": {
          "description": "Unique character identifier",
          "type": "string"
        },
        "isPublicSpawn": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "personality": {
          "type": "string"
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "spawnLocation": {
          "type": [
            "object",
            "null"
          ]
        },
        "systemPrompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "userDescription": {
          "type": [
            "string",
            "null"
          ]
        },
        "userNickname": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Schema version for migrations",
          "type": "integer"
        },
        "voiceMode": {
          "enum": [
            "none",
            "preset",
            "custom_sample"
          ],
          "type": "string"
        },
        "voicePreset": {
          "type": [
            "string",
            "null"
          ]
        },
        "voiceSamplePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "writingInstructions": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "mode",
        "avatarColor",
        "personality",
        "greeting",
        "createdAt"
      ],
      "type": "object"
    },
    "StreamEvent": {
      "description": "Payload of the 'llm-stream' Tauri event (Phase B1). Correlated to its originating request via requestId.",
      "properties": {
        "assistantId": {
          "description": "final only: persisted assistant message id, when persisted",
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "description": "final only: full content so far (may be partial)",
          "type": [
            "string",
            "null"
          ]
        },
        "delta": {
          "description": "chunk only: incremental content fragment",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "description": "final only: failure detail",
          "type": [
            "string",
            "null"
          ]
        },
        "incomplete": {
          "description": "final only: mirrors the persisted ChatMessage.incomplete flag",
          "type": [
            "boolean",
            "null"
          ]
        },
        "kind": {
          "description": "chunk: delta token(s). stalled: no bytes for STREAM_IDLE_CHUNK_TIMEOUT (followed by a final failed event). final: terminal exactly-once event.",
          "enum": [
            "chunk",
            "stalled",
            "final"
          ],
          "type": "string"
        },
        "persisted": {
          "description": "final only: whether NDJSON appends happened",
          "type": [
            "boolean",
            "null"
          ]
        },
        "requestId": {
          "type": "string"
        },
        "status": {
          "description": "final only: terminal lifecycle state",
          "enum": [
            "completed",
            "aborted",
            "failed",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "requestId"
      ],
      "type": "object"
    }
  },
  "version": "1.0"
}