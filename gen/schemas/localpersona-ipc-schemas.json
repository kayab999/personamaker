  "description": "Canonical JSON schemas for LocalPersona IPC types (Tauri commands). This is the contract. Update the golden file when Rust structs change.",
  "schemas": {
    "ChatMessage": {
      "properties": {
        "content": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "images": {
          "items": {
            "$ref": "#/definitions/ImageReference"
          },
          "type": "array"
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "narrator"
          ],
          "type": "string"
        },
        "speaker_id": {
          "type": "string"
        },
        "speaker_name": {
          "type": "string"
        },
        "timestamp": {
          "description": "Epoch millis",
          "type": "integer"
        },
        "token_count": {
          "default": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "speaker_id",
        "speaker_name",
        "content",
        "timestamp",
        "role"
      ],
      "type": "object"
    },
    "ConversationMetadata": {
      "properties": {
        "created_at": {
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "last_message_preview": {
