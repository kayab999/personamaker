            "string",
            "null"
          ]
        },
        "last_message_timestamp": {
          "type": [
            "integer",
            "null"
          ]
        },
        "message_count": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "participant_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "updated_at": {
          "type": "integer"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "version",
        "id",
        "name",
        "participant_ids",
        "created_at",
        "updated_at",
        "message_count"
      ],
      "type": "object"
